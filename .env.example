# Variaveis de ambiente do PastorHub (nunca commitar valores reais; .env esta no .gitignore)
# Obtenha no dashboard do Supabase (supabase.com): URL do projeto e chave publica (anon)
# Sem esses valores publicos, o app opera em modo demonstracao/offline.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Docker Compose: portas publicadas (valores abaixo sao os padroes) ----
# app (producao/nginx) -> http://localhost:8080
APP_PORT=8080
# perfil dev (Vite hot-reload) -> http://localhost:5173
VITE_DEV_PORT=5173
# perfil static (app HTML/JS puro) -> http://localhost:8081
STATIC_PORT=8081
# ---- Servidor (Edge Function ai-proxy) — NUNCA commitar valores reais ----
# Configure com: supabase secrets set NOME=valor
# O app estático usa os MESMOS valores públicos de cima em pastorhub-static/js/config.js
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
