// =============================================================================
// SUPABASE EDGE FUNCTION - Geração de Sermões com OpenAI
// =============================================================================
// 
// Este arquivo é um EXEMPLO de como implementar a Edge Function.
// Para usar:
// 1. Instale o Supabase CLI: npm install -g supabase
// 2. Crie a função: supabase functions new generate-sermon
// 3. Copie este código para: supabase/functions/generate-sermon/index.ts
// 4. Configure a API Key: supabase secrets set OPENAI_API_KEY=sk-...
// 5. Deploy: supabase functions deploy generate-sermon
//
// =============================================================================

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const OPENAI_API_KEY = Deno.env.get("OPENAI_API_KEY")!;
const SUPABASE_URL = Deno.env.get("SUPABASE_URL")!;
const SUPABASE_ANON_KEY = Deno.env.get("SUPABASE_ANON_KEY")!;

/* CORS restrito (ex.: https://devjogerio.github.io). Nunca "*". */
function corsHeaders(req: Request) {
  const permitidas = (Deno.env.get("ALLOWED_ORIGIN") || "").split(",").map((o) => o.trim()).filter(Boolean);
  const origem = req.headers.get("origin") || "";
  if (!origem) return { "Access-Control-Allow-Origin": "", "Content-Type": "application/json", Vary: "Origin" };
  let ok = false;
  for (const p of permitidas) {
    try { ok = ok || new URL(origem).origin === new URL(p).origin; } catch { /* ignore */ }
  }
  if (!ok) return { "Access-Control-Allow-Origin": "", "Content-Type": "application/json", Vary: "Origin" };
  return {
    "Access-Control-Allow-Origin": origem.split(",")[0].trim(),
    "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
    "Access-Control-Allow-Methods": "POST, OPTIONS",
    "Content-Type": "application/json",
    Vary: "Origin",
  };
}

interface SermonRequest {
  titulo?: string;
  texto_biblico: string;
  tema: string;
  publico_alvo: string;
  tipo_sermao: string;
  tom?: string;
  observacoes?: string;
}

const CAMPOS_OBRIGATORIOS = ["texto_biblico", "tema", "publico_alvo", "tipo_sermao"];

serve(async (req) => {
  // CORS headers
  const cors = corsHeaders(req);

  // Handle CORS preflight
  if (req.method === "OPTIONS") return new Response("ok", { headers: cors });

  try {
    // =======================================================================
    // 1. AUTENTICAÇÃO
    // =======================================================================
    const authHeader = req.headers.get("Authorization") || "";
    const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      global: { headers: { Authorization: authHeader } },
    });

    const {
      data: { user },
      error: authError,
    } = await supabase.auth.getUser();

    if (authError || !user) {
      return new Response(JSON.stringify({ error: "Não autorizado" }), {
        status: 401,
        headers: cors,
      });
    }

    // =======================================================================
    // 2. VALIDAÇÃO DE ENTRADA
    // =======================================================================
    const body: SermonRequest = await req.json();

    if (!CAMPOS_OBRIGATORIOS.every((c) => Boolean(body[c]))) {
      return new Response(
        JSON.stringify({
          error: "Campos obrigatórios faltando",
          required: CAMPOS_OBRIGATORIOS,
        }),
        {
          status: 400,
          headers: cors,
        }
      );
    }

    const textoBiblico = String(body.texto_biblico || "").slice(0, 3000);
    const tema = String(body.tema || "").slice(0, 120);
    const tipo = String(body.tipo_sermao || "").slice(0, 80);
    const publico = String(body.publico_alvo || "").slice(0, 120);
    const tom = body.tom ? String(body.tom).slice(0, 60) : undefined;
    const observacoes = body.observacoes ? String(body.observacoes).slice(0, 2000) : undefined;

    // =======================================================================
    // 3. CONSTRUIR PROMPTS PARA OPENAI
    // =======================================================================
    const systemPrompt = `Você é um assistente teológico sábio e experiente, especializado em hermenêutica bíblica e homilética reformada. 
Sua tarefa é criar esboços de sermões estruturados, fiéis às escrituras, biblicamente sólidos e inspiradores.
Use linguagem pastoral acessível, mas teologicamente profunda.
Sempre cite referências bíblicas e mantenha fidelidade ao texto sagrado.`;

    const userPrompt = `Crie um esboço completo de sermão ${tipo} baseado em ${textoBiblico} com o tema "${tema}". 

**ESPECIFICAÇÕES:**
- Público-alvo: ${publico}
- Tom desejado: ${tom || "encorajador e pastoral"}
${observacoes ? `- Observações especiais: ${observacoes}` : ""}

**ESTRUTURA OBRIGATÓRIA:**

**TÍTULO**: [Crie um título impactante e relevante]

**TEXTO BÍBLICO**: ${textoBiblico}

**INTRODUÇÃO**:
- Comece com uma ilustração contemporânea ou histórica relevante
- Contextualize o texto bíblico (autor, audiência, contexto histórico)
- Apresente o tema central de forma clara
- Estabeleça a relevância para o público atual

**DESENVOLVIMENTO** (3 pontos principais):

**I. [Primeiro Ponto Principal]**
   • Exposição do texto bíblico com análise do contexto original
   • Referências cruzadas relevantes (mínimo 2)
   • Aplicação prática para a vida do ouvinte
   • Ilustração contextualizada e impactante

**II. [Segundo Ponto Principal]**
   • Exposição do texto bíblico com análise do contexto original
   • Referências cruzadas relevantes (mínimo 2)
   • Aplicação prática para a vida do ouvinte
   • Ilustração contextualizada e impactante

**III. [Terceiro Ponto Principal]**
   • Exposição do texto bíblico com análise do contexto original
   • Referências cruzadas relevantes (mínimo 2)
   • Aplicação prática para a vida do ouvinte
   • Ilustração contextualizada e impactante

**CONCLUSÃO**:
- Recapitule os três pontos principais de forma concisa
- Faça um apelo prático e transformador
- Termine com esperança e encorajamento bíblico
- Inclua uma oração final ou desafio

**REFERÊNCIAS BÍBLICAS ADICIONAIS**:
Liste 5-7 textos relacionados para aprofundamento com breve explicação

**FORMATAÇÃO:**
Use HTML simples: <h2>, <h3>, <p>, <strong>, <em>, <ul>, <li>
Mantenha o texto limpo e bem estruturado para fácil leitura.`;

    // =======================================================================
    // 4. CHAMADA À API DA OPENAI
    // =======================================================================
    console.log("Chamando OpenAI API...");

    const openaiResponse = await fetch("https://api.openai.com/v1/chat/completions", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${OPENAI_API_KEY}`,
      },
      body: JSON.stringify({
        model: "gpt-4o-mini",
        messages: [
          { role: "system", content: systemPrompt },
          { role: "user", content: userPrompt },
        ],
        temperature: 0.7, // Criatividade balanceada
        max_tokens: 3000, // Limite de tokens para resposta
        top_p: 1,
        frequency_penalty: 0.3, // Evita repetições
        presence_penalty: 0.3, // Incentiva novos tópicos
      }),
    });

    if (!openaiResponse.ok) {
      console.error("OpenAI Error:", await openaiResponse.text());
      // Resposta genérica: não expõe detalhes internos ao cliente.
      return new Response(JSON.stringify({ error: "Erro ao gerar sermão com IA" }), {
        status: 502,
        headers: cors,
      });
    }

    const openaiData = await openaiResponse.json();
    const conteudoHtml = openaiData.choices[0].message.content;

    console.log("Sermão gerado com sucesso!");

    // =======================================================================
    // 5. PROCESSAR RESPOSTA
    // =======================================================================

    // Extrair título do HTML
    const tituloMatch = conteudoHtml.match(/<h2>(.*?)<\/h2>/);
    const titulo = String(body.titulo || "").trim() || (tituloMatch ? String(tituloMatch[1]).trim() : "Novo Sermão");

    // Gerar texto puro (sem HTML)
    const conteudoPlain = conteudoHtml
      .replace(/<[^>]*>/g, "")
      .replace(/\s+/g, " ")
      .trim()
      .substring(0, 1000);

    // Gerar tags automáticas
    const tags: string[] = [];
    tags.push(tema.toLowerCase());

    const livro = textoBiblico.split(" ")[0].toLowerCase();
    if (livro) tags.push(livro);

    // =======================================================================
    // 6. SALVAR NO BANCO DE DADOS
    // =======================================================================
    const { data: sermon, error: insertError } = await supabase
      .from("sermoes")
      .insert({
        user_id: user.id,
        titulo: titulo,
        texto_biblico: textoBiblica,
        tema: tema,
        publico_alvo: publico,
        tipo_sermao: tipo,
        conteudo_html: conteudoHtml,
        conteudo_plain: conteudoPlain,
        tags: tags,
        status_pregado: false,
        data_criacao: new Date().toISOString(),
      })
      .select()
      .single();

    if (insertError) {
      console.error("Insert Error:", insertError);
      return new Response(
        JSON.stringify({
          error: "Erro ao salvar sermão no banco de dados",
        }),
        {
          status: 500,
          headers: cors,
        }
      );
    }

    // =======================================================================
    // 7. RETORNAR SUCESSO
    // =======================================================================
    console.log("Sermão salvo com sucesso! ID:", sermon.id);

    return new Response(
      JSON.stringify({
        success: true,
        sermon: sermon,
        usage: {
          prompt_tokens: openaiData.usage?.prompt_tokens,
          completion_tokens: openaiData.usage?.completion_tokens,
          total_tokens: openaiData.usage?.total_tokens,
        },
      }),
      {
        status: 200,
        headers: cors,
      }
    );
  } catch (error) {
    console.error("Error:", error);
    return new Response(
      JSON.stringify({
        error: "Erro interno do servidor",
      }),
      {
        status: 500,
        headers: cors,
      }
    );
  }
});

// =============================================================================
// TESTES LOCAIS
// =============================================================================
