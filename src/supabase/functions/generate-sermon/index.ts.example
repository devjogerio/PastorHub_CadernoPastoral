// 3. Teste com curl:
/*
curl -i --location --request POST 'http://localhost:54321/functions/v1/generate-sermon' \
  --header 'Authorization: Bearer YOUR_ANON_KEY' \
  --header 'Content-Type: application/json' \
  --data '{
    "texto_biblico": "João 3:16",
    "tema": "Amor de Deus",
    "publico_alvo": "Geral",
    "tipo_sermao": "Expositivo",
    "tom": "Encorajador"
  }'
*/
